    "%@ config data was requested over the admin channel but no response has been returned from the remote node." : {
      "localizations" : {
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ конфигурациони подаци су затражени преко административног канала, али никакав одговор није враћен са удаљеног чвора."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已通过管理频道请求 %@ 配置数据，但远程节点未返回任何响应。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 組態資料已透過管理通道要求，但遠端節點尚未回覆。"
          }
        }
      }
    },
