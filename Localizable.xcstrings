    },
    "The format used to display GPS coordinates on the device screen." : {
      "localizations" : {
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Формат који се користи за приказивање GPS координата на екрану уређаја."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在设备屏幕上显示 GPS 坐标的格式。"
